option(
    'erase_min_geometry',
    type: 'integer',
    min: 0,
    max: 18446744073709551615,
    value: 10,
    description: 'The min size allowed in bytes, used by the geometry check',
)
option(
    'erase_max_geometry',
    type: 'integer',
    min: 0,
    max: 18446744073709551615,
    value: 9223372036854775807,
    description: 'the max size allowed in bytes, used by the geometry check',
)
option(
    'highspeed_parts',
    type: 'array',
    value: [],
    deprecated: true,
    description: 'Ignored. Kept for compatibility with existing build configurations',
)

option(
    'enable_trim',
    type: 'feature',
    description: 'Enable TRIM for eMMC devices',
)
option('tests', type: 'feature', value: 'enabled', description: 'Build tests')
